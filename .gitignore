# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
local.properties

# Heap dumps. gradle.properties runs the daemon with -Xmx4g and
# -XX:+HeapDumpOnOutOfMemoryError, so an OOM drops a multi-GB .hprof next to the build.
*.hprof

# Android
*.apk
*.aab
*.aar
*.ap_
*.dex
captures/
.cxx/
.externalNativeBuild/
release/
out/

# Tests. Nothing under src/test or src/androidTest reaches a published artifact, and the
# release pipeline runs with -xtest, so they are kept out of the repository.
**/src/test/
**/src/androidTest/
**/src/testFixtures/
**/src/testDebug/
**/src/testRelease/

# Test and analysis reports that land outside build/ when a task is pointed elsewhere.
**/test-results/
**/reports/
.kotlin/sessions/

# Scratch and merge leftovers
*.tmp
*.bak
*.orig
*.rej

# What must STAY tracked, in case a future rule gets careless:
#   fieldtrack-*/consumer-rules.pro   — shipped with the AAR
#   fieldtrack-core/schemas/          — Room schemas; migrations are real (EC-83)

# IDE
.idea/
*.iml
*.ipr
*.iws
.kotlin/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs
*.log

# Secrets — never commit signing keys, map keys or routing API keys.
# MAPS_API_KEY lives in local.properties (ignored above) and reaches the build as a
# manifest placeholder and BuildConfig field; see local.properties.template and
# docs/BUILD.md §1. There is no committed fallback — a default that "just works" is worth
# very little next to a credential readable by anyone with repo access, in every clone.
*.jks
*.keystore
*.p12
*.pem
keystore.properties
secrets.properties
/.artifacts

# Per-developer Firebase project for the sample (FCM remote wake)
sample-android/google-services.json
