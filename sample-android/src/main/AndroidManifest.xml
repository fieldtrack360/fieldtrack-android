<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Note what is NOT here: no location permissions, no service, no receivers.
      They all merge in from the fieldtrack-core AAR (PERMISSIONS.md §8 item 6).
    -->

    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <application
        android:name="com.field360.fieldtrack.sample.SampleApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_trackit"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_trackit"
        android:supportsRtl="true"
        android:theme="@style/Theme.FieldTrackSample">

        <!-- Empty when no key is configured; the Track/Debug screens detect that and
             explain rather than showing a blank map. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Optional release license token for the SDK. Blank is fine in debug builds,
             where the offline gate is waived. The name must be TrackItLicense exactly:
             LicenseGate.infoPlistKey reads that and nothing else, so the earlier
             "TrackerLicense" spelling here was silently ignored and the manifest route
             never worked. -->
        <meta-data
            android:name="TrackItLicense"
            android:value="${TRACKER_LICENSE}" />

        <!--
          Takes WorkManager's initialisation off the cold-start path.

          `WorkManagerInitializer` runs inside `androidx.startup`'s ContentProvider, which
          the platform executes during Application attach on EVERY cold start of the
          process — before `Application.onCreate`, on the main thread. That is ordinarily
          just a slow start; here it is a crash risk, because the process most often starts
          cold in answer to `startForegroundService()` (a sticky restart, a boot resume, an
          OEM revival), and the platform's ~10 second start-foreground deadline opens at
          that call. Every provider in the merged manifest runs inside the window before
          `TrackingService` is even constructed, and overrunning it is
          `ForegroundServiceDidNotStartInTimeException` — fatal, and uncatchable by the SDK.

          Removing it normally forces this Application to implement
          `Configuration.Provider`. It does not here: `WorkManagerAccess` inside
          fieldtrack-core initialises WorkManager with the identical default configuration
          the first time the SDK asks for a handle. So this block is manifest-only, and it
          is the recommended integration for any host of this SDK.

          One caveat, and it is the reason the SDK does not ship this removal in its own
          manifest: if the HOST calls `WorkManager.getInstance()` itself before the SDK has
          taken a handle, it throws. A host that schedules its own work either keeps this
          block out, or implements `Configuration.Provider` as AndroidX documents.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Lets the capture log be shared to Drive/mail/adb-less laptops. Read-only,
             not exported, and scoped to the external files dir only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="com.field360.fieldtrack.sample.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
