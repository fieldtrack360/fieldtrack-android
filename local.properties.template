# Copy to `local.properties` and fill in. That file is gitignored — never commit it,
# and never put a real value in this template.
#
# Everything here is optional. With none of it set the sample still builds and runs —
# the map screens say a key is missing rather than showing a blank map.

# Android SDK location. Android Studio writes this for you on first sync.
#sdk.dir=/path/to/Android/sdk

# Google Maps key for the Track and Debug screens.
# Restrict it to this app's package + signing certificate in Google Cloud Console;
# an unrestricted key is billable by anyone who finds it.
#MAPS_API_KEY=

# OSRM base URL for road snapping. Leave unset unless you run your own instance.
#
# Unset is a working configuration: no RoadSnapProvider is installed, buildTrack never
# leaves the device, and the track renders from raw fixes. Setting it makes the polyline
# follow the road network instead of the fixes.
#
# Point this at a deployment you control. The public demo server documents no availability
# guarantee and no rate limit worth relying on, and sending a fleet's traces to it is both
# unreliable and somebody else's bill.
#OSRM_BASE_URL=https://osrm.internal.example.com

# Upload endpoint for TrackerSync — the FULL URL the batch is POSTed to, not a base.
#
# Unset is a working configuration and the default: the sample configures no upload half,
# points accumulate in Room, and nothing opens a socket. That is the offline-first
# behaviour the SDK is built around, so the sample has to keep demonstrating it.
#
# Set it and the sample turns on autoSync — points upload as they are accepted, a backlog
# recorded offline drains when connectivity returns, and the Home screen shows how many
# rows are still queued.
#
# Not a credential, so the usual warning does not apply — but it is per-developer. A dev
# tunnel URL is ephemeral and points at one laptop, which is why there is no default.
#SYNC_URL=https://api.example.com/locations

# FieldTrack licence API root, for the SDK's revocation check. Include the version
# segment — the transport appends `/verify` and nothing else, so `/api/v2` later is a
# configuration change rather than an SDK release.
#
# Unset is a working configuration and the default: with no URL, and with no response
# public key compiled in, the check makes no request and every start carries on.
#
# This keeps the endpoint out of version control, not out of the artifact. It is compiled
# into `BuildConfig.LICENSE_BASE_URL` and readable in any published AAR or installed APK.
# That is fine for a URL the device has to reach. Never put a credential here.
#
# CI and JitPack have no `local.properties`. Pass `-PfieldtrackLicenseUrl=...` or set
# `FIELDTRACK_LICENSE_URL` in the environment there; both take precedence over this file.
#FIELDTRACK_LICENSE_URL=https://licence.example.com/api/v1

# Licence-token signing keys, as `kid:base64` pairs — e.g. `1:AbC…=,2:XyZ…=`.
#
# A map rather than a single value even with one entry today: tokens carry the `kid` they
# were signed with, so rotating adds a key instead of replacing one. Shipping one value now
# means an SDK release later, at the moment a key has to change.
#
# Blank is the default and it is honest rather than convenient: with no keys, every
# non-debuggable build fails the offline gate with "Unknown license key id". Debuggable
# installs are waived, so this is invisible until a release build.
#
# From Admin -> Settings -> System configuration. CI: -PfieldtrackLicenseKeys=... or
# FIELDTRACK_LICENSE_KEYS in the environment.
#FIELDTRACK_LICENSE_KEYS=1:Base64OfThirtyTwoRawBytes=

# The key that verifies `/verify` RESPONSES. Standard base64 of 32 raw bytes.
#
# A different key from the one above, deliberately: one authenticates what was issued, the
# other authenticates what the server says about it today. Hold both.
#
# Blank leaves the online check inert — no request is made, no response is ever trusted.
# CI: -PfieldtrackResponseKey=... or FIELDTRACK_RESPONSE_KEY.
#FIELDTRACK_RESPONSE_KEY=Base64OfThirtyTwoRawBytes=
